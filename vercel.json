{
  "outputDirectory": "dist",
  "functions": {
    "api/generate-pr.ts": {
      "maxDuration": 60
    },
    "api/transcribe.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
